{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "rootDir": "src",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/test*.ts",
    "src/**/*.spec.ts",
    "src/test.ts",
    "src/**/*.ispec.ts",
    "e2e/**/*"
  ]
}
