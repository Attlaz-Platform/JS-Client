# This is a PUBLIC package published to the public npm registry under the @attlaz scope.
# The user-level ~/.npmrc routes @attlaz -> the private GitLab registry (for internal packages);
# this project-level override points @attlaz back to npmjs so publish and resolution here target
# the public registry. No auth token belongs in this file — npmjs credentials live in ~/.npmrc.
@attlaz:registry=https://registry.npmjs.org
