{
  "name": "attlaz-client",
  "version": "1.39.0",
  "description": "Javascript Client to access Attlaz API",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "type": "module",
  "./package.json": {
    "default": "./package.json"
  },
  ".": {
    "types": "./dist/src/index.d.ts",
    "default": "./dist/src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/attlaz/javascript-client.git"
  },
  "homepage": "https://attlaz.com",
  "keywords": [
    "attlaz",
    "client",
    "http",
    "api"
  ],
  "files": [
    "dist/*"
  ],
  "sideEffects": false,
  "author": "Stijn Duynslaeger <stijn@attlaz.com> (stijn@attlaz.com)",
  "license": "MIT",
  "scripts": {
    "prebuild": "npm run setversion",
    "prepare": "npm run clean && tsc --project tsconfig.production.json && npm run setversion",
    "build": "npm run clean && tsc",
    "setversion": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "clean": "rimraf dist",
    "scan": "docker run -v .:/path zricethezav/gitleaks:latest detect --source=\"/path\" ",
    "test": "jest"
  },
  "publishConfig": {
    "cache": "~/.npm",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "axios-oauth-client": "^2.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "eslint-config-attlaz-base": "^1.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.3.4",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^30.0.4",
    "rimraf": "^6.0.1",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-typescript": "^1.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "directories": {
    "test": "test"
  }
}
