{
  "name": "attlaz-client",
  "version": "1.17.4",
  "description": "Javascript Client to access Attlaz API",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "type": "module",
  "./package.json": {
    "default": "./package.json"
  },
  ".": {
    "types": "./dist/src/index.d.ts",
    "default": "./dist/src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/attlaz/javascript-client.git"
  },
  "homepage": "https://attlaz.com",
  "keywords": [
    "attlaz",
    "client",
    "http",
    "api"
  ],
  "files": [
    "dist/*"
  ],
  "author": "Stijn Duynslaeger <stijn@attlaz.com> (stijn@attlaz.com)",
  "license": "MIT",
  "scripts": {
    "prebuild": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "prepare": "npm run clean && tsc --project tsconfig.production.json",
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "scan": "docker run -v .:/path zricethezav/gitleaks:latest detect --source=\"/path\" ",
    "test": "jest"
  },
  "publishConfig": {
    "cache": "~/.npm",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "axios-oauth-client": "^2.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^22.1.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "dotenv": "^16.3.1",
    "eslint": "^8.42.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsdoc": "^50.4.3",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-promise": "^7.0.0",
    "jest": "^29.5.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-typescript": "^1.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.4"
  },
  "directories": {
    "test": "test"
  }
}
