{
  "name": "@attlaz/client",
  "version": "1.125.0",
  "description": "Javascript Client to access Attlaz API",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "default": "./dist/*",
      "types": "./dist/*"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attlaz-Platform/JS-Client.git"
  },
  "homepage": "https://attlaz.com",
  "keywords": [
    "attlaz",
    "client",
    "http",
    "api"
  ],
  "files": [
    "dist/*"
  ],
  "sideEffects": false,
  "author": "Stijn Duynslaeger <stijn@attlaz.com> (stijn@attlaz.com)",
  "license": "MIT",
  "scripts": {
    "prebuild": "npm run setversion",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepare": "npm run clean && npm run tsc -- --project tsconfig.build.json && npm run setversion",
    "build": "npm run clean && npm run tsc -- -p tsconfig.build.json",
    "setversion": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "clean": "rimraf dist",
    "scan": "docker run -v .:/path zricethezav/gitleaks:latest detect --source=\"/path\" ",
    "test": "vitest run --mode unit",
    "typecheck": "npm run tsc -- --project tsconfig.json --noEmit",
    "test-integration": "vitest run --mode integration",
    "test-live": "vitest --mode unit",
    "tsc": "node node_modules/@typescript/native/bin/tsc",
    "typecheck:ts6": "tsc6 --project tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-config-attlaz-base": "^1.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "directories": {
    "test": "test"
  }
}
